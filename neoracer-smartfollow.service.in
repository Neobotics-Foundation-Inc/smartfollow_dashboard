[Unit]
Description=Neoracer Smart Follow Dashboard (port 8085)
After=neoracer-teleop.service

[Service]
Type=exec
User=racecar
Group=racecar
ExecStart=/bin/bash -c '\
    source /opt/ros/humble/setup.bash && \
    source /home/racecar/ros2_ws/install/setup.bash && \
    exec python3 @DIR@/smartfollow.py'
Restart=on-failure
RestartSec=5
Environment=HOME=/home/racecar
WorkingDirectory=@DIR@

[Install]
WantedBy=multi-user.target
